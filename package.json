{
  "name": "app-template",
  "private": true,
  "version": "0.1.0",
  "description": "{{APP_NAME}}",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run check:wiki && npm run licences && npm run build && npm test && npm run test:e2e",
    "check:wiki": "node scripts/check-wiki.mjs",
    "licences": "node scripts/check-licences.mjs",
    "backup": "node scripts/backup.mjs",
    "setup": "node scripts/setup.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
